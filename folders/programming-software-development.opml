<opml version="2.0"><head><title>Programming &amp; Software Development — RSS Feeds</title><dateCreated>Sat, 31 Oct 2026 00:00:00 +0000</dateCreated></head><body><outline text="Programming &amp; Software Development" title="Programming &amp; Software Development"><outline type="rss" text="Hacker News" title="Hacker News" xmlUrl="https://news.ycombinator.com/rss" htmlUrl="https://news.ycombinator.com/" description="Broad programming, computing, software and technology discussions." /><outline type="rss" text="Lobsters" title="Lobsters" xmlUrl="https://lobste.rs/rss" htmlUrl="https://lobste.rs/" description="Curated technical links and thoughtful software engineering discussions." /><outline type="rss" text="GitHub Blog" title="GitHub Blog" xmlUrl="https://github.blog/feed/" htmlUrl="https://github.blog/" description="GitHub platform, developer tooling and open-source ecosystem news." /><outline type="rss" text="GitHub Changelog" title="GitHub Changelog" xmlUrl="https://github.blog/changelog/feed/" htmlUrl="https://github.blog/changelog/" description="New GitHub features, product changes and platform announcements." /><outline type="rss" text="GitHub Security Blog" title="GitHub Security Blog" xmlUrl="https://github.blog/category/security/feed/" htmlUrl="https://github.blog/category/security/" description="Software supply-chain security, vulnerabilities and GitHub security updates." /><outline type="rss" text="Python Insider" title="Python Insider" xmlUrl="https://blog.python.org/rss.xml" htmlUrl="https://blog.python.org/" description="Official Python language and project announcements." /><outline type="rss" text="The Rust Blog" title="The Rust Blog" xmlUrl="https://blog.rust-lang.org/feed.xml" htmlUrl="https://blog.rust-lang.org/" description="Rust releases, language design and project updates." /><outline type="rss" text="Simon Willison's Weblog" title="Simon Willison's Weblog" xmlUrl="https://simonwillison.net/atom/everything/" htmlUrl="https://simonwillison.net/" description="Practical Python, SQLite, web development, AI tooling and software experiments." /><outline type="rss" text="Real Python" title="Real Python" xmlUrl="https://realpython.com/atom.xml" htmlUrl="https://realpython.com/" description="Python tutorials, techniques and programming education." /><outline type="rss" text="DEV Community" title="DEV Community" xmlUrl="https://dev.to/feed" htmlUrl="https://dev.to/" description="Developer-written tutorials, project write-ups and programming discussion; can be high-volume." /></outline></body></opml>