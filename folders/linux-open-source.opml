<opml version="2.0"><head><title>Linux &amp; Open Source — RSS Feeds</title><dateCreated>Sat, 31 Oct 2026 00:00:00 +0000</dateCreated></head><body><outline text="Linux &amp; Open Source" title="Linux &amp; Open Source"><outline type="rss" text="Arch Linux News" title="Arch Linux News" xmlUrl="https://archlinux.org/feeds/news/" htmlUrl="https://archlinux.org/" description="Official Arch Linux announcements, package news and required manual interventions." /><outline type="rss" text="9to5Linux" title="9to5Linux" xmlUrl="https://9to5linux.com/feed/" htmlUrl="https://9to5linux.com/" description="Linux distributions, desktop environments, kernel and application news." /><outline type="rss" text="It's FOSS" title="It's FOSS" xmlUrl="https://itsfoss.com/feed/" htmlUrl="https://itsfoss.com/" description="Linux tutorials, desktop apps and open-source software." /><outline type="rss" text="LWN.net" title="LWN.net" xmlUrl="https://lwn.net/headlines/rss" htmlUrl="https://lwn.net/" description="In-depth Linux kernel, open-source and systems engineering coverage." /><outline type="rss" text="Phoronix" title="Phoronix" xmlUrl="https://www.phoronix.com/rss.php" htmlUrl="https://www.phoronix.com/" description="Linux performance, AMD/Intel graphics, drivers and hardware benchmarks. Some readers may encounter anti-bot blocks." /><outline type="rss" text="DistroWatch" title="DistroWatch" xmlUrl="https://distrowatch.com/news/dw.xml" htmlUrl="https://distrowatch.com/" description="Linux and BSD distribution releases and ecosystem news." /><outline type="rss" text="Fedora Magazine" title="Fedora Magazine" xmlUrl="https://fedoramagazine.org/feed/" htmlUrl="https://fedoramagazine.org/" description="Linux guides, desktop tips and open-source articles." /></outline></body></opml>