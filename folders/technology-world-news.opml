<opml version="2.0"><head><title>Technology &amp; World News — RSS Feeds</title><dateCreated>Sat, 31 Oct 2026 00:00:00 +0000</dateCreated></head><body><outline text="Technology &amp; World News" title="Technology &amp; World News"><outline type="rss" text="Ars Technica" title="Ars Technica" xmlUrl="https://feeds.arstechnica.com/arstechnica/index" htmlUrl="https://arstechnica.com/" description="In-depth computing, technology, science and gaming journalism." /><outline type="rss" text="The Verge" title="The Verge" xmlUrl="https://www.theverge.com/rss/index.xml" htmlUrl="https://www.theverge.com/" description="Technology, internet culture, gadgets, gaming and science." /><outline type="rss" text="WIRED" title="WIRED" xmlUrl="https://www.wired.com/feed/rss" htmlUrl="https://www.wired.com/" description="Technology, science, culture, privacy and digital life." /><outline type="rss" text="404 Media" title="404 Media" xmlUrl="https://www.404media.co/rss/" htmlUrl="https://www.404media.co/" description="Independent reporting on technology, surveillance and internet culture." /><outline type="rss" text="The Guardian - Australia" title="The Guardian - Australia" xmlUrl="https://www.theguardian.com/australia-news/rss" htmlUrl="https://www.theguardian.com/au" description="Australian news, politics, society and current affairs." /><outline type="rss" text="BBC News - World" title="BBC News - World" xmlUrl="https://feeds.bbci.co.uk/news/world/rss.xml" htmlUrl="https://www.bbc.com/news/world" description="International news and major world events." /><outline type="rss" text="BBC News - Technology" title="BBC News - Technology" xmlUrl="https://feeds.bbci.co.uk/news/technology/rss.xml" htmlUrl="https://www.bbc.com/news/technology" description="Technology, science and internet news." /><outline type="rss" text="xkcd" title="xkcd" xmlUrl="https://xkcd.com/rss.xml" htmlUrl="https://xkcd.com/" description="Science, maths, programming and internet humour." /></outline></body></opml>