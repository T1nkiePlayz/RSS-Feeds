<opml version="2.0"><head><title>Space &amp; Science — RSS Feeds</title><dateCreated>Sat, 31 Oct 2026 00:00:00 +0000</dateCreated></head><body><outline text="Space &amp; Science" title="Space &amp; Science"><outline type="rss" text="NASA News" title="NASA News" xmlUrl="https://www.nasa.gov/feed/" htmlUrl="https://www.nasa.gov/" description="NASA missions, research, agency announcements and space exploration." /><outline type="rss" text="NASA Astronomy Picture of the Day" title="NASA Astronomy Picture of the Day" xmlUrl="https://apod.nasa.gov/apod.rss" htmlUrl="https://apod.nasa.gov/" description="Daily astronomy image with an explanatory science note." /><outline type="rss" text="NASA Image of the Day" title="NASA Image of the Day" xmlUrl="https://www.nasa.gov/feeds/iotd-feed/" htmlUrl="https://www.nasa.gov/" description="NASA space, science and mission photography." /><outline type="rss" text="Phys.org - Astronomy" title="Phys.org - Astronomy" xmlUrl="https://phys.org/rss-feed/space-news/astronomy/" htmlUrl="https://phys.org/space-news/astronomy/" description="Astronomy, astrophysics and space research reporting." /><outline type="rss" text="Phys.org - Space Exploration" title="Phys.org - Space Exploration" xmlUrl="https://phys.org/rss-feed/space-news/space-exploration/" htmlUrl="https://phys.org/space-news/space-exploration/" description="Spacecraft, missions, exploration and related research." /><outline type="rss" text="ScienceDaily - Space &amp; Time" title="ScienceDaily - Space &amp; Time" xmlUrl="https://www.sciencedaily.com/rss/space_time.xml" htmlUrl="https://www.sciencedaily.com/news/space_time/" description="New research in astronomy, cosmology and space science." /><outline type="rss" text="Space.com" title="Space.com" xmlUrl="https://www.space.com/feeds/all" htmlUrl="https://www.space.com/" description="Astronomy, telescopes, planetary science and human spaceflight." /><outline type="rss" text="r/space" title="r/space" xmlUrl="https://www.reddit.com/r/space/.rss" htmlUrl="https://www.reddit.com/r/space/" description="Space news, launches, astronomy and community discussion." /></outline></body></opml>