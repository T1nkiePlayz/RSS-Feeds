<?xml version='1.0' encoding='utf-8'?>
<opml version="2.0"><head><title>Ashton's RSS Feeds</title><dateCreated>Sat, 31 Oct 2026 00:00:00 +0000</dateCreated></head><body><outline text="Linux &amp; Open Source" title="Linux &amp; Open Source"><outline type="rss" text="Arch Linux News" title="Arch Linux News" xmlUrl="https://archlinux.org/feeds/news/" htmlUrl="https://archlinux.org/" description="Official Arch Linux announcements, package news and required manual interventions." /><outline type="rss" text="9to5Linux" title="9to5Linux" xmlUrl="https://9to5linux.com/feed/" htmlUrl="https://9to5linux.com/" description="Linux distributions, desktop environments, kernel and application news." /><outline type="rss" text="It's FOSS" title="It's FOSS" xmlUrl="https://itsfoss.com/feed/" htmlUrl="https://itsfoss.com/" description="Linux tutorials, desktop apps and open-source software." /><outline type="rss" text="LWN.net" title="LWN.net" xmlUrl="https://lwn.net/headlines/rss" htmlUrl="https://lwn.net/" description="In-depth Linux kernel, open-source and systems engineering coverage." /><outline type="rss" text="Phoronix" title="Phoronix" xmlUrl="https://www.phoronix.com/rss.php" htmlUrl="https://www.phoronix.com/" description="Linux performance, AMD/Intel graphics, drivers and hardware benchmarks. Some readers may encounter anti-bot blocks." /><outline type="rss" text="DistroWatch" title="DistroWatch" xmlUrl="https://distrowatch.com/news/dw.xml" htmlUrl="https://distrowatch.com/" description="Linux and BSD distribution releases and ecosystem news." /><outline type="rss" text="Fedora Magazine" title="Fedora Magazine" xmlUrl="https://fedoramagazine.org/feed/" htmlUrl="https://fedoramagazine.org/" description="Linux guides, desktop tips and open-source articles." /></outline><outline text="Programming &amp; Software Development" title="Programming &amp; Software Development"><outline type="rss" text="Hacker News" title="Hacker News" xmlUrl="https://news.ycombinator.com/rss" htmlUrl="https://news.ycombinator.com/" description="Broad programming, computing, software and technology discussions." /><outline type="rss" text="Lobsters" title="Lobsters" xmlUrl="https://lobste.rs/rss" htmlUrl="https://lobste.rs/" description="Curated technical links and thoughtful software engineering discussions." /><outline type="rss" text="GitHub Blog" title="GitHub Blog" xmlUrl="https://github.blog/feed/" htmlUrl="https://github.blog/" description="GitHub platform, developer tooling and open-source ecosystem news." /><outline type="rss" text="GitHub Changelog" title="GitHub Changelog" xmlUrl="https://github.blog/changelog/feed/" htmlUrl="https://github.blog/changelog/" description="New GitHub features, product changes and platform announcements." /><outline type="rss" text="GitHub Security Blog" title="GitHub Security Blog" xmlUrl="https://github.blog/category/security/feed/" htmlUrl="https://github.blog/category/security/" description="Software supply-chain security, vulnerabilities and GitHub security updates." /><outline type="rss" text="Python Insider" title="Python Insider" xmlUrl="https://blog.python.org/rss.xml" htmlUrl="https://blog.python.org/" description="Official Python language and project announcements." /><outline type="rss" text="The Rust Blog" title="The Rust Blog" xmlUrl="https://blog.rust-lang.org/feed.xml" htmlUrl="https://blog.rust-lang.org/" description="Rust releases, language design and project updates." /><outline type="rss" text="Simon Willison's Weblog" title="Simon Willison's Weblog" xmlUrl="https://simonwillison.net/atom/everything/" htmlUrl="https://simonwillison.net/" description="Practical Python, SQLite, web development, AI tooling and software experiments." /><outline type="rss" text="Real Python" title="Real Python" xmlUrl="https://realpython.com/atom.xml" htmlUrl="https://realpython.com/" description="Python tutorials, techniques and programming education." /><outline type="rss" text="DEV Community" title="DEV Community" xmlUrl="https://dev.to/feed" htmlUrl="https://dev.to/" description="Developer-written tutorials, project write-ups and programming discussion; can be high-volume." /></outline><outline text="Web Development &amp; Design" title="Web Development &amp; Design"><outline type="rss" text="CSS-Tricks" title="CSS-Tricks" xmlUrl="https://css-tricks.com/feed/" htmlUrl="https://css-tricks.com/" description="CSS techniques, frontend development and browser capabilities." /><outline type="rss" text="Smashing Magazine" title="Smashing Magazine" xmlUrl="https://www.smashingmagazine.com/feed/" htmlUrl="https://www.smashingmagazine.com/" description="Web design, UX, accessibility and frontend engineering." /><outline type="rss" text="Mozilla Hacks" title="Mozilla Hacks" xmlUrl="https://hacks.mozilla.org/feed/" htmlUrl="https://hacks.mozilla.org/" description="Browser technology, JavaScript, web standards and platform engineering." /><outline type="rss" text="A List Apart" title="A List Apart" xmlUrl="https://alistapart.com/main/feed/" htmlUrl="https://alistapart.com/" description="Thoughtful articles about web standards, design and accessible web experiences." /><outline type="rss" text="Cloudflare Blog" title="Cloudflare Blog" xmlUrl="https://blog.cloudflare.com/rss/" htmlUrl="https://blog.cloudflare.com/" description="Internet infrastructure, web performance, networking and security." /><outline type="rss" text="Supabase Status" title="Supabase Status" xmlUrl="https://status.supabase.com/history.atom" htmlUrl="https://status.supabase.com/" description="Operational incidents and service status updates for Supabase." /></outline><outline text="Game Development" title="Game Development"><outline type="rss" text="Godot Engine News" title="Godot Engine News" xmlUrl="https://godotengine.org/rss.xml" htmlUrl="https://godotengine.org/" description="Official Godot engine announcements, releases and development news." /><outline type="rss" text="Game Developer" title="Game Developer" xmlUrl="https://www.gamedeveloper.com/rss.xml" htmlUrl="https://www.gamedeveloper.com/" description="Game design, development, production, postmortems and industry coverage." /><outline type="rss" text="Godot (Lemmy)" title="Godot (Lemmy)" xmlUrl="https://programming.dev/feeds/c/godot.xml?sort=Hot" htmlUrl="https://programming.dev/c/godot" description="Active Godot community: projects, questions, demos, tutorials and engine discussion." /><outline type="rss" text="Game Development (Lemmy)" title="Game Development (Lemmy)" xmlUrl="https://programming.dev/feeds/c/gamedev.xml?sort=Hot" htmlUrl="https://programming.dev/c/gamedev" description="Active game development community: projects, technical discussion, design and development experiences." /></outline><outline text="Gaming &amp; Minecraft" title="Gaming &amp; Minecraft"><outline type="rss" text="GamingOnLinux" title="GamingOnLinux" xmlUrl="https://www.gamingonlinux.com/article_rss.php?newsonly" htmlUrl="https://www.gamingonlinux.com/" description="Linux gaming, Steam, Proton, compatibility and releases." /><outline type="rss" text="Modrinth News" title="Modrinth News" xmlUrl="https://modrinth.com/news/feed/rss.xml" htmlUrl="https://modrinth.com/" description="Official Modrinth platform and Minecraft modding ecosystem announcements." /><outline type="rss" text="PC Gamer" title="PC Gamer" xmlUrl="https://www.pcgamer.com/rss/" htmlUrl="https://www.pcgamer.com/" description="PC gaming news, releases, reviews and hardware coverage." /><outline type="rss" text="Minecraft (Lemmy)" title="Minecraft (Lemmy)" xmlUrl="https://lemmy.world/feeds/c/minecraft.xml?sort=Hot" htmlUrl="https://lemmy.world/c/minecraft" description="Minecraft builds, updates, mods, community projects and discussion." /><outline type="rss" text="Linux Gaming (Lemmy)" title="Linux Gaming (Lemmy)" xmlUrl="https://lemmy.world/feeds/c/linux_gaming.xml?sort=Hot" htmlUrl="https://lemmy.world/c/linux_gaming" description="Linux gaming, Steam, Proton, compatibility, troubleshooting and releases." /></outline><outline text="Space &amp; Science" title="Space &amp; Science"><outline type="rss" text="NASA News" title="NASA News" xmlUrl="https://www.nasa.gov/feed/" htmlUrl="https://www.nasa.gov/" description="NASA missions, research, agency announcements and space exploration." /><outline type="rss" text="NASA Astronomy Picture of the Day" title="NASA Astronomy Picture of the Day" xmlUrl="https://science.nasa.gov/feed/apod-basic/" htmlUrl="https://apod.nasa.gov/" description="Daily astronomy image with an explanatory science note." /><outline type="rss" text="NASA Image of the Day" title="NASA Image of the Day" xmlUrl="https://www.nasa.gov/feeds/iotd-feed/" htmlUrl="https://www.nasa.gov/" description="NASA space, science and mission photography." /><outline type="rss" text="Phys.org - Astronomy" title="Phys.org - Astronomy" xmlUrl="https://phys.org/rss-feed/space-news/astronomy/" htmlUrl="https://phys.org/space-news/astronomy/" description="Astronomy, astrophysics and space research reporting." /><outline type="rss" text="Phys.org - Space Exploration" title="Phys.org - Space Exploration" xmlUrl="https://phys.org/rss-feed/space-news/space-exploration/" htmlUrl="https://phys.org/space-news/space-exploration/" description="Spacecraft, missions, exploration and related research." /><outline type="rss" text="ScienceDaily - Space &amp; Time" title="ScienceDaily - Space &amp; Time" xmlUrl="https://www.sciencedaily.com/rss/space_time.xml" htmlUrl="https://www.sciencedaily.com/news/space_time/" description="New research in astronomy, cosmology and space science." /><outline type="rss" text="Space.com" title="Space.com" xmlUrl="https://www.space.com/feeds/all" htmlUrl="https://www.space.com/" description="Astronomy, telescopes, planetary science and human spaceflight." /><outline type="rss" text="Space (Lemmy)" title="Space (Lemmy)" xmlUrl="https://lemmy.ml/feeds/c/space.xml?sort=Hot" htmlUrl="https://lemmy.ml/c/space" description="Active space community covering launches, missions, astronomy and space science." /></outline><outline text="Cybersecurity &amp; Privacy" title="Cybersecurity &amp; Privacy"><outline type="rss" text="Schneier on Security" title="Schneier on Security" xmlUrl="https://www.schneier.com/feed/atom/" htmlUrl="https://www.schneier.com/" description="Security, cryptography, privacy and security policy analysis." /><outline type="rss" text="Krebs on Security" title="Krebs on Security" xmlUrl="https://krebsonsecurity.com/feed/" htmlUrl="https://krebsonsecurity.com/" description="Investigative cybersecurity reporting and online threats." /><outline type="rss" text="CISA Alerts" title="CISA Alerts" xmlUrl="https://www.cisa.gov/cybersecurity-advisories/alerts.xml" htmlUrl="https://www.cisa.gov/cybersecurity-advisories" description="Official US cybersecurity alerts and vulnerability advisories." /><outline type="rss" text="The Register - Security" title="The Register - Security" xmlUrl="https://www.theregister.com/security/headlines.atom" htmlUrl="https://www.theregister.com/security/" description="Security news, vulnerabilities and enterprise technology reporting." /></outline><outline text="Technology &amp; World News" title="Technology &amp; World News"><outline type="rss" text="Ars Technica" title="Ars Technica" xmlUrl="https://feeds.arstechnica.com/arstechnica/index" htmlUrl="https://arstechnica.com/" description="In-depth computing, technology, science and gaming journalism." /><outline type="rss" text="The Verge" title="The Verge" xmlUrl="https://www.theverge.com/rss/index.xml" htmlUrl="https://www.theverge.com/" description="Technology, internet culture, gadgets, gaming and science." /><outline type="rss" text="WIRED" title="WIRED" xmlUrl="https://www.wired.com/feed/rss" htmlUrl="https://www.wired.com/" description="Technology, science, culture, privacy and digital life." /><outline type="rss" text="404 Media" title="404 Media" xmlUrl="https://www.404media.co/rss/" htmlUrl="https://www.404media.co/" description="Independent reporting on technology, surveillance and internet culture." /><outline type="rss" text="The Guardian - Australia" title="The Guardian - Australia" xmlUrl="https://www.theguardian.com/australia-news/rss" htmlUrl="https://www.theguardian.com/au" description="Australian news, politics, society and current affairs." /><outline type="rss" text="BBC News - World" title="BBC News - World" xmlUrl="https://feeds.bbci.co.uk/news/world/rss.xml" htmlUrl="https://www.bbc.com/news/world" description="International news and major world events." /><outline type="rss" text="BBC News - Technology" title="BBC News - Technology" xmlUrl="https://feeds.bbci.co.uk/news/technology/rss.xml" htmlUrl="https://www.bbc.com/news/technology" description="Technology, science and internet news." /><outline type="rss" text="xkcd" title="xkcd" xmlUrl="https://xkcd.com/rss.xml" htmlUrl="https://xkcd.com/" description="Science, maths, programming and internet humour." /></outline><outline text="Pixel Art &amp; Creative" title="Pixel Art &amp; Creative"><outline type="rss" text="Pixel Art (Lemmy)" title="Pixel Art (Lemmy)" xmlUrl="https://retrolemmy.com/feeds/c/pixelart.xml?sort=Hot" htmlUrl="https://retrolemmy.com/c/pixelart" description="Active pixel-art community for artwork, techniques and inspiration, including work made with Aseprite." /></outline><outline text="Self-hosting &amp; Homelab" title="Self-hosting &amp; Homelab"><outline type="rss" text="Self-hosting (Lemmy)" title="Self-hosting (Lemmy)" xmlUrl="https://lemmy.world/feeds/c/selfhosted.xml?sort=Hot" htmlUrl="https://lemmy.world/c/selfhosted" description="Active self-hosting community covering applications, services, home servers, infrastructure and privacy." /></outline><outline text="Discovery &amp; New Projects" title="Discovery &amp; New Projects"><outline type="rss" text="Show HN" title="Show HN" xmlUrl="https://hnrss.org/show" htmlUrl="https://news.ycombinator.com/show" description="Developer-built projects, experiments, tools and websites." /><outline type="rss" text="Product Hunt" title="Product Hunt" xmlUrl="https://www.producthunt.com/feed" htmlUrl="https://www.producthunt.com/" description="Newly launched software, apps and digital products." /></outline></body></opml>